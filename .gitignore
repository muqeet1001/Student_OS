# dependencies
node_modules/
.pnp
.pnp.js

# builds
dist/
build/
*.tsbuildinfo

# environment
# server/.env is committed deliberately so collaborators can run the project
# without setting up their own credentials. Anything in it is readable by
# anyone with repository access — rotate the Atlas password and JWT secrets
# if that ever stops being acceptable.
.env
.env.local
.env.*.local
!.env.example
!server/.env

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# uploads (user generated content)
server/uploads/*
!server/uploads/.gitkeep

# editor / os
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# test output
coverage/
.nyc_output/
