# ---------------------------------------------------------------------------
# Copy this file to `server/.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
# Use a MongoDB Atlas URI, a local mongod, or leave blank in development to
# spin up an ephemeral in-memory MongoDB (data is lost on restart).
MONGO_URI=

# Auth — generate strong random values, e.g. `openssl rand -hex 48`
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# AI provider (OpenAI-compatible endpoint)
# Leave AI_API_KEY blank to run against the built-in deterministic mock provider.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Code execution sandbox
CODE_RUNNER_TIMEOUT_MS=4000
CODE_RUNNER_MAX_OUTPUT=10000
