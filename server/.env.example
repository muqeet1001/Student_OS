# ---------------------------------------------------------------------------
# Copy to `server/.env` and fill in real values. Never commit `.env`.
#
#   cp server/.env.example server/.env
#
# Values marked REQUIRED must be set before NODE_ENV=production will boot —
# the server throws on startup rather than running with insecure defaults.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------

NODE_ENV=development
PORT=5000

# Origin allowed by CORS and used to build absolute links.
# In production this is your deployed frontend URL, e.g. https://studentos.app
# When the API also serves the built client (single service), leave it as the
# same origin the API runs on.
CLIENT_URL=http://localhost:5173


# --- Database (REQUIRED in production) -------------------------------------

# MongoDB Atlas, or a local mongod (mongodb://127.0.0.1:27017/student_os).
#
# IMPORTANT: include the database name before the query string, or Mongo
# writes to `test` and the seed will appear to do nothing:
#                                        ┌── database name
#   mongodb+srv://user:pass@cluster.mongodb.net/student_os?retryWrites=true&w=majority
#
# Atlas also needs your server's IP under Network Access. Leave blank in
# development to boot an ephemeral in-memory MongoDB (data is lost on restart).
MONGO_URI=


# --- Auth (REQUIRED in production) -----------------------------------------

# Generate each one separately:  openssl rand -hex 48
# They must differ — a single secret lets an access token be replayed as a
# refresh token.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Access tokens are short-lived because they cannot be revoked; the refresh
# token is rotated on every use and stored server-side so it can be.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d


# --- AI interview scoring (OPTIONAL) ---------------------------------------

# Interview answers are scored by a deterministic rule-based analyzer that
# needs no external service. Setting a key enables richer model-based
# feedback on top; leaving it blank is fully supported.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini


# --- Code runner (OPTIONAL) ------------------------------------------------

# Per-submission limits for the sandboxed judge. Raise the timeout only if
# your host is slow; it is the main defence against an infinite loop.
CODE_RUNNER_TIMEOUT_MS=4000
CODE_RUNNER_MAX_OUTPUT=10000

# Live code execution. Judge0 CE currently accepts no-key educational/demo
# traffic at this endpoint. For a managed/RapidAPI account, set the key and
# header supplied by the provider. Local fallback is enabled by default only
# in development. Keep it false in production: node:vm is not a security
# boundary, so an outage must not move untrusted code into the web container.
CODE_RUNNER_PROVIDER=judge0
CODE_RUNNER_API_URL=https://ce.judge0.com
CODE_RUNNER_API_KEY=
CODE_RUNNER_API_KEY_HEADER=X-RapidAPI-Key
# Optional provider-specific JavaScript language ID. Blank auto-selects the
# newest installed Node.js runtime reported by the provider.
CODE_RUNNER_LANGUAGE_ID=
CODE_RUNNER_REMOTE_TIMEOUT_MS=15000
CODE_RUNNER_FALLBACK_LOCAL=false

# Signs the rotating attendance check-in codes. Its own secret rather than a
# JWT one, because these codes are shown on a projector to a whole room.
CHECKIN_SECRET=change-me-to-a-long-random-string

# Optional email delivery for announcements. Without these, announcements
# still reach students in the app and are reported as "not emailed" rather
# than being claimed as sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Student OS <no-reply@yourcollege.edu>

# Optional WhatsApp provider adapter. Student OS sends a POST containing
# {to, template, variables}; point this at your approved provider gateway.
# Delivery additionally requires institution enablement and student opt-in.
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=
