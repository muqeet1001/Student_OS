{
  "name": "student-os",
  "private": true,
  "version": "1.0.0",
  "description": "Student OS — a placement readiness platform for students (MERN)",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "seed": "npm run seed --workspace server",
    "lint": "eslint client server e2e eslint.config.js --max-warnings=0",
    "test": "npm run test --workspaces --if-present",
    "test:fast": "npm run test:fast --workspace server",
    "seed:demo": "npm run seed --workspace server -- --demo",
    "seed:fresh": "npm run seed --workspace server -- --fresh",
    "seed:demo:fresh": "npm run seed --workspace server -- --demo --fresh",
    "e2e": "node e2e/smoke.mjs",
    "e2e:journeys": "npm run e2e --workspace client",
    "e2e:authz": "node e2e/authz.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "playwright": "^1.62.1"
  },
  "engines": {
    "node": ">=20"
  }
}
